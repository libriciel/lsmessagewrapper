{
    "name": "libriciel/ls-message-wrapper",
    "description": "Wrapper PHP de l'API lsmessage, avec vérification du contenu des SMS avant envoi",
    "license": "MIT",
    "authors": [
        {
            "name": "Théo GUILLON",
            "email": "theo.guillon@libriciel.coop",
            "homepage": "https://www.libriciel.fr",
            "role": "Project Manager"
        },
        {
            "name": "Antonin RABATEL",
            "email": "antonin.rabatel@libriciel.coop",
            "homepage": "https://www.libriciel.fr",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.3",
        "psr/http-client": "^1.0.2",
        "psr/http-factory": "^1.0.2",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.2",
        "symplify/easy-coding-standard": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Libriciel\\LsMessageWrapper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Libriciel\\LsMessageWrapper\\Test\\": "tests/"
        }
    }
}
